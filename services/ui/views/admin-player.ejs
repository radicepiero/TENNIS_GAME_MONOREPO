<%- include('partials/head'); -%>
<link rel="stylesheet" href="/css/hamburger.css" />
<link rel="stylesheet" href="/css/admin.css" />
<link rel="stylesheet" href="/css/pronostico.css" />
<title>Admin Player</title>
<%- include('partials/header'); -%>
<%- include('partials/hamburger'); -%>

<div class="admin-page admin-page--narrow">
  <div class="admin-search-wrap">
    <input
      id="playerSearch"
      type="text"
      placeholder="Cerca giocatore per nome o paese..."
      class="admin-search-input"
    />
    <div
      id="searchResults"
      class="admin-search-results"
    ></div>
  </div>

  <h1 id="player-title" class="admin-title-center"></h1>

  <div class="admin-row">
    <div id="player-card-wrap"></div>

    <div class="admin-card admin-card-flex">
      <div class="admin-card-title">Modifica dati</div>
      <form id="player-form">
        <input type="hidden" id="player-id" name="id" />

        <div class="admin-form-grid-row">
          <div class="admin-field-label">name</div>
          <input id="f-name" name="name" type="text" required />
        </div>

        <div class="admin-form-grid-row">
          <div class="admin-field-label">first_name</div>
          <input id="f-first_name" name="first_name" type="text" />
        </div>

        <div class="admin-form-grid-row">
          <div class="admin-field-label">second_name</div>
          <input id="f-second_name" name="second_name" type="text" />
        </div>

        <div class="admin-form-grid-row">
          <div class="admin-field-label">country</div>
          <input id="f-country" name="country" type="text" />
        </div>

        <div class="admin-form-grid-row">
          <div class="admin-field-label">profile_url</div>
          <input id="f-profile_url" name="profile_url" type="url" />
        </div>

        <div class="admin-form-grid-row">
          <div class="admin-field-label">image_src</div>
          <input id="f-image_src" name="image_src" type="text" />
        </div>

        <div class="admin-form-grid-row admin-form-grid-row--last">
          <div class="admin-field-label">image_alt</div>
          <input id="f-image_alt" name="image_alt" type="text" />
        </div>

        <div class="admin-form-actions">
          <a id="open-public" class="admin-link" href="#">apri pagina friend</a>
          <button id="save-btn" type="submit">Salva</button>
        </div>
      </form>
      <div id="save-status" class="admin-status"></div>
    </div>
  </div>
</div>

<script>
  document.documentElement.dataset.apiUrl = "<%= apiUrl %>";
  document.documentElement.dataset.playerId = "<%= playerId %>";
</script>

<script type="module" src="/js/ui/pages/admin-player.js"></script>

<%- include('partials/footer'); -%>
