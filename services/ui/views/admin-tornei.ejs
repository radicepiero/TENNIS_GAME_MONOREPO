<%- include('partials/head'); -%>
<link rel="stylesheet" href="/css/hamburger.css" />
<link rel="stylesheet" href="/css/admin.css" />
<%- include('partials/header'); -%> <%- include('partials/hamburger'); -%>

<h1>Admin Tornei</h1>

<div id="admin-tournaments" class="admin-page" data-api-url="<%= apiUrl %>">
  <div style="max-width: 1100px; margin: 0 auto; text-align: left; padding: 0 12px;">
    <div class="admin-card admin-card--compact" style="margin-top: 14px;">
      <h2 style="margin: 0 0 10px 0;">Aggiorna ranking tennisti</h2>
      <div class="admin-actionbar">
        <label>Ranking date
          <input id="ranking-import-date" type="date" />
        </label>
        <input id="ranking-import-file" type="file" accept=".csv,text/csv" />
        <button id="ranking-import-run" type="button">Carica CSV e aggiorna</button>
        <span id="ranking-import-status"></span>
      </div>
    </div>

    <div class="admin-section admin-row admin-row--between">
      <h2 style="margin: 0;">Tornei</h2>
      <button id="open-create" type="button" aria-label="Aggiungi torneo" title="Aggiungi torneo" style="width: 36px; height: 36px; font-size: 22px; line-height: 1;">+</button>
    </div>

    <div id="create-modal" class="admin-modal">
      <div id="create-modal-overlay" class="admin-modal__overlay"></div>
      <div class="admin-modal__panel">
        <div class="admin-modal__header">
          <h3>Nuovo torneo</h3>
          <button id="close-create" type="button" aria-label="Chiudi" title="Chiudi">X</button>
        </div>

        <form id="create-tournament" class="admin-modal__form">
          <label>Nome<input name="name" type="text" required /></label>
          <label>Href<input name="href" type="text" required /></label>
          <label>Categoria<input name="category" type="text" /></label>
          <label>Luogo<input name="location" type="text" required /></label>
          <label>Paese
            <input name="country" id="country" list="countries" type="text" required />
            <datalist id="countries"></datalist>
          </label>
          <label>Superficie (material)
            <select name="surface_material" id="surface-material" required>
              <option value="hard">Hard</option>
              <option value="clay">Clay</option>
              <option value="grass">Grass</option>
              <option value="carpet">Carpet</option>
            </select>
          </label>
          <label>Superficie (indoor)
            <input name="surface_indoor" id="surface-indoor" type="checkbox" value="1" />
          </label>
          <label>Superficie (color)
            <input name="surface_color" id="surface-color" type="color" value="#000000" />
          </label>
          <label>Montepremi<input name="prizemoney" type="number" required value="0" /></label>
          <label>Valuta
            <select name="currency" required>
              <option value="€">Euro (€)</option>
              <option value="$">Dollaro ($)</option>
            </select>
          </label>
          <label>Data inizio<input name="datainizio" type="date" required /></label>
          <label>Data fine<input name="datafine" type="date" required /></label>
          <label>Stato
            <select name="status" required>
              <option value="excluded">Escluso</option>
              <option value="upcoming">In Arrivo</option>
              <option value="open">Open</option>
              <option value="in-progress">In Corso</option>
              <option value="completed">Completato</option>
            </select>
          </label>
          <label>Chiusura Pronostici
            <input name="chiusuraPronostici" type="datetime-local" />
          </label>
          <label>Ranking date
            <select name="ranking_date" id="ranking-date" style="width: 100%;">
              <option value="">(vuoto)</option>
            </select>
          </label>
          <label>Rounds
            <select name="rounds" id="rounds">
              <option value="">(vuoto)</option>
            </select>
          </label>
          <label>Costo partecipazione<input name="costopartecipazione" type="number" step="0.5" value="5" required /></label>

          <div class="admin-modal__footer">
            <span id="create-status" class="admin-status-inline"></span>
            <button type="button" id="cancel-create">Annulla</button>
            <button type="submit">Crea</button>
          </div>
        </form>
      </div>
    </div>

    <h2 style="margin-top: 30px;">Elenco tornei</h2>
    <div class="admin-filterbar">
      <label>Filtro nome<input id="filter-name" type="text" placeholder="cerca..." /></label>
      <label>Anno
        <select id="filter-year">
          <option value="">Tutti</option>
          <option value="2025">2025</option>
          <option value="2026">2026</option>
        </select>
      </label>
      <button id="reload">Ricarica</button>
      <span id="list-status"></span>
    </div>

    <div class="admin-table-wrap" style="overflow-x: auto;">
      <table id="tournaments-table" class="admin-table" style="width: 100%; border-collapse: collapse;">
        <thead>
          <tr>
            <th>ID</th>
            <th>Nome</th>
            <th>Inizio</th>
            <th>Fine</th>
            <th>Status</th>
            <th>Pronostici</th>
            <th>Albero</th>
            <th>Azioni</th>
          </tr>
        </thead>
        <tbody></tbody>
      </table>
    </div>
  </div>
</div>

<script type="module" src="/js/ui/pages/admin-tornei.js"></script>
<%- include('partials/footer'); -%>
