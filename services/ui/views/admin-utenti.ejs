<%- include('partials/head'); -%>
<link rel="stylesheet" href="/css/hamburger.css" />
<link rel="stylesheet" href="/css/admin.css" />
<%- include('partials/header'); -%> <%- include('partials/hamburger'); -%>

<h1>Admin Utenti</h1>

<div id="admin-users" class="admin-page admin-page--users" data-api-url="<%= apiUrl %>">
  <h2>Crea utente friend</h2>

  <div class="admin-modal__form" style="max-width: 700px;">
    <label>Email
      <input id="new-email" type="email" placeholder="email" />
    </label>
    <label>Soprannome
      <input id="new-soprannome" type="text" placeholder="soprannome" />
    </label>
    <label>Password
      <input id="new-password" type="password" placeholder="password" autocomplete="new-password" />
    </label>
    <label>Conferma password
      <input id="new-password-confirm" type="password" placeholder="conferma" autocomplete="new-password" />
    </label>
  </div>

  <div class="admin-actionbar admin-actionbar--compact" style="margin-top: 12px;">
    <button id="create-friend" type="button">Crea friend</button>
    <span id="create-status"></span>
  </div>

  <hr class="admin-hr" />

  <h2>Utenti</h2>
  <div class="admin-actionbar admin-actionbar--compact">
    <button id="reload" type="button">Ricarica</button>
    <span id="list-status"></span>
  </div>

  <div class="admin-table-wrap" style="overflow-x:auto;">
    <table id="users-table" class="admin-table" style="width:100%; border-collapse: collapse;">
      <thead>
        <tr>
          <th>UUID</th>
          <th>Email</th>
          <th>Soprannome</th>
          <th>Level</th>
          <th>Azioni</th>
        </tr>
      </thead>
      <tbody></tbody>
    </table>
  </div>
</div>

<script type="module" src="/js/ui/pages/admin-utenti.js"></script>
<%- include('partials/footer'); -%>
