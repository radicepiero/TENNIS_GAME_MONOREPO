<%- include('partials/head'); -%>
<link rel="stylesheet" href="https://fperucic.github.io/treant-js/Treant.css" />
<link rel="stylesheet" href="/css/treantTree.css" />
<link rel="stylesheet" href="/css/hamburger.css" />
<title id="title"></title>
<%- include('partials/header'); -%>
<%- include('partials/hamburger'); -%>

<h1 id="nome-torneo"><%= tournamentId %></h1>

<div id="floating-toolbar" class="floating-toolbar">
  <div class="floating-toolbar__header">
    <div class="floating-toolbar__handle" id="floating-toolbar-handle"></div>
    <button id="floating-toolbar-toggle" type="button" class="floating-toolbar__toggle"></button>
  </div>
  <div class="floating-toolbar__content">
    <button id="saveButton" class="hidden">SALVA</button>
    <button id="deleteButton" class="hidden">ELIMINA</button>
    <button id="generatePredictionButton" class="hidden">GENERA PRONOSTICO</button>
    <div id="filter-bar" class="hidden">
      <div class="filter-box">
        <label class="filter-label">
          <span class="label-text">Da:</span>
          <select id="fromRound"></select>
        </label>
        <label class="filter-label">
          <span class="label-text">A:</span>
          <select id="toRound"></select>
        </label>
      </div>
    </div>
  </div>
</div>

<div id="warning" class="hidden" style="margin: 10px 0; padding: 10px; border: 1px solid #f5c2c7; background: #f8d7da; color: #842029;"></div>

<div id="scroll-container">
  <div id="chart-container">
    <div id="tree-simple" class="Treant"></div>
  </div>
</div>

<div id="dialogContainer"></div>

<script src="https://fperucic.github.io/treant-js/vendor/raphael.js"></script>
<script src="https://fperucic.github.io/treant-js/Treant.js"></script>

<div
  id="page-bootstrap"
  data-api-url="<%= apiUrl %>"
  data-tournament-id="<%= tournamentId %>"
  data-user='<%- JSON.stringify(user || null) %>'
></div>
<script type="module" src="/js/ui/pages/albero-pronostico.js?v=<%= Date.now() %>"></script>

<%- include('partials/footer'); -%>
