<%- include('partials/head'); -%>
<link rel="stylesheet" href="/css/hamburger.css" />
<link rel="stylesheet" href="/css/annual-ranking.css" />
<title>Classifica annuale</title>
<%- include('partials/header'); -%>
<%- include('partials/hamburger'); -%>

<div class="annual-ranking-page">
  <h1>Classifica annuale</h1>

  <div class="controls">
    <label>
      Anno:
      <select id="yearSelect"></select>
    </label>
  </div>

  <div class="table-container">
    <table id="annualRankingTable">
      <thead>
        <tr id="annualRankingHeader">
          <th class="tournament-col">TORNEO/LUDOPATICO</th>
        </tr>
      </thead>
      <tbody id="annualRankingBody"></tbody>
      <tfoot>
        <tr id="annualRankingTotals">
          <th class="tournament-col">PUNTI MATURATI</th>
        </tr>
      </tfoot>
    </table>
  </div>
</div>

<script>
  (function () {
    const apiUrl = "<%= apiUrl %>";
    const initialYear = Number("<%= year %>");

    const yearSelect = document.getElementById("yearSelect");
    const headerRow = document.getElementById("annualRankingHeader");
    const bodyEl = document.getElementById("annualRankingBody");
    const totalsRow = document.getElementById("annualRankingTotals");

    const yNow = new Date().getFullYear();
    const years = [];
    for (let y = yNow; y >= yNow - 6; y--) years.push(y);

    years.forEach((y) => {
      const opt = document.createElement("option");
      opt.value = String(y);
      opt.textContent = String(y);
      if (y === initialYear) opt.selected = true;
      yearSelect.appendChild(opt);
    });

    const clearTable = () => {
      while (headerRow.children.length > 1) headerRow.removeChild(headerRow.lastChild);
      bodyEl.innerHTML = "";
      while (totalsRow.children.length > 1) totalsRow.removeChild(totalsRow.lastChild);
    };

    const cellText = (v) => {
      const n = Number(v);
      return Number.isFinite(n) ? String(n) : "0";
    };

    const render = (data) => {
      clearTable();

      const users = (data && data.users) || [];
      const tournaments = (data && data.tournaments) || [];
      const points = (data && data.points) || {};
      const totals = (data && data.totals) || {};
      const rowMax = (data && data.rowMax) || {};

      users.forEach((u) => {
        const th = document.createElement("th");
        th.className = "user-col";
        th.textContent = (u && u.soprannome) || "";
        headerRow.appendChild(th);

        const tdTot = document.createElement("td");
        tdTot.className = "total-cell";
        tdTot.textContent = cellText(totals[u.uuid]);
        totalsRow.appendChild(tdTot);
      });

      tournaments.forEach((t) => {
        const tr = document.createElement("tr");
        const status = (t && t.status) ? String(t.status) : "";
        if (status) tr.classList.add(`status-${status}`);
        const th = document.createElement("th");
        th.className = "tournament-col";
        th.textContent = (t && t.name) || "";
        tr.appendChild(th);

        const max = Number(rowMax[String(t.id)]) || 0;
        const rowPoints = points[String(t.id)] || {};

        users.forEach((u) => {
          const td = document.createElement("td");
          const v = Number(rowPoints[u.uuid]) || 0;
          td.textContent = cellText(v);
          if (max > 0 && v === max) td.classList.add("row-max");
          tr.appendChild(td);
        });

        bodyEl.appendChild(tr);
      });
    };

    const fetchAnnualRanking = async (year) => {
      const res = await fetch(`${apiUrl}/annual-ranking/${encodeURIComponent(year)}`, {
        method: "GET",
        headers: { "Accept": "application/json" },
      });
      if (!res.ok) {
        const txt = await res.text().catch(() => "");
        throw new Error(`HTTP ${res.status} ${txt}`);
      }
      const json = await res.json();
      return json && json.data ? json.data : null;
    };

    const load = async () => {
      const y = yearSelect.value;
      try {
        const data = await fetchAnnualRanking(y);
        render(data);
      } catch (e) {
        console.error("Errore caricamento classifica annuale:", e);
        clearTable();
      }
    };

    yearSelect.addEventListener("change", () => {
      const y = yearSelect.value;
      window.history.replaceState({}, "", `/classifica-annuale/${encodeURIComponent(y)}`);
      load();
    });

    load();
  })();
</script>

<%- include('partials/footer'); -%>
