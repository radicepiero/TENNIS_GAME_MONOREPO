<%- include('partials/head'); -%>
<title>Modifica Player</title>
<%- include('partials/header'); -%>

<!-- Barra di ricerca -->
<div
  class="search-container"
  style="max-width: 600px; margin: 20px auto; position: relative"
>
  <input
    type="text"
    id="playerSearch"
    placeholder="Cerca giocatore per nome, cognome o paese..."
    style="
      width: 100%;
      padding: 10px;
      font-size: 16px;
      border: 1px solid #ccc;
      border-radius: 4px;
    "
  />
  <div
    id="searchResults"
    style="
      position: absolute;
      width: 100%;
      background: white;
      border: 1px solid #ccc;
      max-height: 200px;
      overflow-y: auto;
      display: none;
      z-index: 1000;
    "
  ></div>
</div>

<div style="width: 100">
  <h1 style="text-align: center"><%= player.name %></h1>

  <h3><%= player.country %></h3>
  <img src="<%= player.image_src %>" alt="<%= player.image_alt %>" />

  <div id="rankingsContainer"></div>
</div>
<form id="form">
  <fieldset>
    <input
      type="hidden"
      id="player-id"
      name="id"
      value="<%= player.id %>"
    /><br />

    <label for="player-name">Nome:</label>
    <input
      type="text"
      id="player-name"
      name="name"
      value="<%= player.name %>"
      required
    /><br />
    <label for="player-first_name">Nome:</label>
    <input
      type="text"
      id="player-first_name"
      name="name"
      value="<%= player.first_name %>"
      required
    /><br />
    <label for="player-second_name">Cognome:</label>
    <input
      type="text"
      id="player-second_name"
      name="name"
      value="<%= player.second_name %>"
      required
    /><br />
    <label for="player-country">Nazione:</label>
    <input
      type="text"
      id="player-country"
      name="country"
      value="<%= player.country %>"
    /><br />

    <label for="player-profile-url">Profilo URL:</label>
    <input
      type="url"
      id="player-profile-url"
      name="profile_url"
      value="<%= player.profile_url %>"
    /><br />

    <label for="player-image-src">Immagine (src):</label>
    <input
      type="text"
      id="player-image-src"
      name="image_src"
      value="<%= player.image_src %>"
    /><br />
    <label for="player-image-alt">Immagine (alt):</label>
    <input
      type="text"
      id="player-image-alt"
      name="image_alt"
      value="<%= player.image_alt %>"
    /><br />

    <button type="submit">Salva</button>
  </fieldset>
</form>
<script type="application/json" id="bootstrap"><%- JSON.stringify({ apiUrl, player }) %></script>
<script type="module" src="/js/ui/pages/edit-player.js?v=<%= Date.now() %>"></script>
<%- include('partials/footer'); -%>
