<%- include('partials/head'); -%>
<link rel="stylesheet" href="/css/hamburger.css" />
<link rel="stylesheet" href="/css/tornei.css" />
<link rel="stylesheet" href="/css/friend-home.css" />
<title>Home</title>
<%- include('partials/header'); -%>
<%- include('partials/hamburger'); -%>

<div class="friend-home">
  <div class="friend-home__header">
    <h1>Home</h1>
    <div class="friend-home__sub">Tornei e pronostici</div>
  </div>

  <div id="warning" class="friend-home__warning hidden"></div>

  <div class="friend-home__grid">
    <section class="card" id="currentTournament"></section>
    <section class="card" id="nextTournaments"></section>
  </div>

  <section class="card" id="recentTournaments"></section>

  <section class="card" id="usefulLinks"></section>
</div>

<script>
  (function () {
    const apiUrl = "<%= apiUrl %>";

    const warningEl = document.getElementById("warning");
    const currentEl = document.getElementById("currentTournament");
    const nextEl = document.getElementById("nextTournaments");
    const recentEl = document.getElementById("recentTournaments");
    const linksEl = document.getElementById("usefulLinks");

    function showWarning(msg) {
      warningEl.textContent = msg;
      warningEl.classList.remove("hidden");
    }

    function normalizeYmd(v) {
      if (!v) return "";
      const s = String(v);
      return s.length >= 10 ? s.slice(0, 10) : s;
    }

    function fmtDate(v) {
      if (!v) return "";
      const s = String(v);
      return s.length >= 10 ? s.slice(0, 10) : s;
    }

    function statusBadge(status) {
      const st = status ? String(status).toLowerCase() : "";
      return `<span class="badge badge--${st}">${st || ""}</span>`;
    }

    function formatDmyShort(v) {
      const ymd = normalizeYmd(v);
      if (!ymd || ymd.length < 10) return ymd;
      const parts = ymd.split("-");
      if (parts.length < 3) return ymd;
      const yyyy = parts[0];
      const mm = parts[1];
      const dd = parts[2];
      if (!yyyy || !mm || !dd) return ymd;
      return `${dd}-${mm}-${String(yyyy).slice(-2)}`;
    }

    function countryToFlag(countryRaw) {
      const c = String(countryRaw || "").trim().toLowerCase();
      const map = {
        italia: "IT",
        australia: "AU",
        spagna: "ES",
        francia: "FR",
        germania: "DE",
        olanda: "NL",
        monaco: "MC",
        qatar: "QA",
        "stati uniti": "US",
        argentina: "AR",
        brasile: "BR",
        canada: "CA",
        cina: "CN",
        giappone: "JP",
        regno: "GB",
        "regno unito": "GB",
        svezia: "SE",
        svizzera: "CH",
        emirati: "AE",
        "emirati arabi": "AE",
        "emirati arabi uniti": "AE",
      };
      const code = map[c];
      if (!code || code.length !== 2) return "🏳️";
      const A = 0x1f1e6;
      const pts = code
        .toUpperCase()
        .split("")
        .map((ch) => A + ch.charCodeAt(0) - 65);
      return String.fromCodePoint(...pts);
    }

    function getTournamentStatus(t) {
      return t && t.status ? String(t.status).toLowerCase() : "";
    }

    function statusLabel(statusRaw) {
      const st = String(statusRaw || "").toLowerCase();
      if (st === "excluded") return "torneo escluso dal gioco";
      if (st === "open") return "Fai il tuo pronostico";
      if (st === "in-progress") return "Segui i risultati dei pronostici";
      if (st === "completed") return "Verifica il punteggio";
      return st;
    }

    function statusHref(t) {
      const st = getTournamentStatus(t);
      if (st === "open") return `/tornei/${t.id}/pronostico`;
      if (st === "in-progress" || st === "completed") return `/tornei/${t.id}/sviluppo`;
      return "";
    }

    function statusShadowClass(status) {
      const st = status ? String(status).toLowerCase() : "";
      if (st === "upcoming") return "tournament-card--shadow-upcoming";
      if (st === "open") return "tournament-card--shadow-open";
      if (st === "in-progress") return "tournament-card--shadow-in-progress";
      return "";
    }

    function surfaceBackgroundClass(surfaceRaw) {
      const s = String(surfaceRaw || "").toLowerCase();
      if (s.includes("grass")) return "tournament-card--surface-grass";
      if (s.includes("clay")) return "tournament-card--surface-clay";
      if (s.includes("hard")) return "tournament-card--surface-hard";
      if (s.includes("carpet")) return "tournament-card--surface-carpet";
      return "tournament-card--surface-other";
    }

    const superuserTreeExistsCache = new Map();
    async function checkSuperuserTreeExists(tournamentId) {
      const key = String(tournamentId);
      if (superuserTreeExistsCache.has(key)) {
        const v = superuserTreeExistsCache.get(key);
        return typeof v === "boolean" ? v : await v;
      }
      const p = (async () => {
        try {
          const res = await fetch(
            `${apiUrl}/trees/superuser/${encodeURIComponent(tournamentId)}`,
            { method: "GET", credentials: "include" }
          );
          if (!res.ok) return false;
          const json = await res.json().catch(() => null);
          return Boolean(json && (json.id || json.uuid));
        } catch (e) {
          return false;
        }
      })();
      superuserTreeExistsCache.set(key, p);
      const ok = await p;
      superuserTreeExistsCache.set(key, ok);
      return ok;
    }

    function buildTournamentCard(tournament) {
      const container = document.createElement("div");
      container.className = [
        "tournament-card",
        statusShadowClass(tournament.status),
        surfaceBackgroundClass(tournament.surface),
      ]
        .filter(Boolean)
        .join(" ");

      const header = document.createElement("div");
      header.className = "tournament-card__header";
      header.style.backgroundImage = tournament.image ? `url('${tournament.image}')` : "none";

      const category = document.createElement("div");
      category.className = "tournament-card__category";
      category.textContent = `${tournament.category || ""}`;

      const title = document.createElement("div");
      title.className = "tournament-card__title";
      title.textContent = String(tournament.nickname || tournament.name || "").trim();

      const meta = document.createElement("div");
      meta.className = "tournament-card__meta";

      const statusText = statusLabel(tournament.status);
      const href = statusHref(tournament);
      const statusEl = href
        ? `<a class="tournament-status-link" href="${href}">${statusText}</a>`
        : `<button type="button" class="tournament-status-link tournament-status-link--disabled" aria-disabled="true">${statusText}</button>`;

      const city = tournament.location || "";
      const country = tournament.country || "";
      const flag = countryToFlag(country);
      const where = city || country
        ? `<span class="tournament-where" data-country-wrap><span class="tournament-city">${city}</span><button type="button" class="tournament-flag" data-country-toggle aria-label="Nazione">${flag}</button><span class="tournament-country is-hidden" data-country-name>${country}</span></span>`
        : "";

      const openRow = tournament.dataopen ? `<div>open: ${formatDmyShort(tournament.dataopen)}</div>` : "";

      const st = getTournamentStatus(tournament);
      const maybeEasyWin = st === "open"
        ? `<a class="tournament-status-link tournament-easywin-btn is-hidden" data-easywin-btn data-tournament-id="${tournament.id}" href="/tornei/${tournament.id}/albero-pronostico">usa il tabellone per vincere facile</a>`
        : "";

      const superLabel = st === "open" ? "tabellone" : "guarda i risultati";
      const superBtn = `<a class="tournament-status-link tournament-superuser-tree-btn is-hidden" data-superuser-tree-btn data-tournament-id="${tournament.id}" href="/tornei/${tournament.id}/albero-superuser">${superLabel}</a>`;

      meta.innerHTML = `
        <div>${statusEl}</div>
        ${maybeEasyWin}
        ${superBtn}
        <div>dal ${formatDmyShort(tournament.datainizio)} al ${formatDmyShort(tournament.datafine)}</div>
        ${openRow}
        <div>${where}</div>
      `;

      header.appendChild(category);
      header.appendChild(title);
      header.appendChild(meta);
      container.appendChild(header);

      // country toggle
      container.addEventListener("click", (e) => {
        const btn = e.target && e.target.closest ? e.target.closest("[data-country-toggle]") : null;
        if (!btn) return;
        const wrap = btn.closest("[data-country-wrap]");
        if (!wrap) return;
        const name = wrap.querySelector("[data-country-name]");
        if (!name) return;
        name.classList.toggle("is-hidden");
      });

      // superuser tree dependent actions
      {
        const easywinBtn = meta.querySelector("[data-easywin-btn]");
        const superTreeBtn = meta.querySelector("[data-superuser-tree-btn]");
        const maybeHasSuperTree = typeof tournament.hasSuperTree === "boolean" ? tournament.hasSuperTree : null;

        const applyExists = (exists) => {
          if (!exists) return;
          if (superTreeBtn) superTreeBtn.classList.remove("is-hidden");
          if (st === "open") {
            if (easywinBtn) easywinBtn.classList.remove("is-hidden");
          }
        };

        if (maybeHasSuperTree === true) {
          applyExists(true);
        } else if (maybeHasSuperTree === false) {
          // keep hidden
        } else {
          checkSuperuserTreeExists(tournament.id).then((exists) => applyExists(exists));
        }
      }

      return container;
    }

    function renderCurrent(t) {
      if (!t) {
        currentEl.innerHTML = `<div class="card__title">Torneo in corso</div><div class="card__empty">Nessun torneo in corso</div>`;
        return;
      }

      currentEl.innerHTML = `<div class="card__title">Torneo in corso</div>`;
      const grid = document.createElement("div");
      grid.className = "tournament-grid";
      grid.appendChild(buildTournamentCard(t));
      currentEl.appendChild(grid);
    }

    function renderNext(list, year) {

      nextEl.innerHTML = `<div class="card__title">Prossimi tornei</div>`;
      const grid = document.createElement("div");
      grid.className = "tournament-grid";
      const topTwo = (list || []).slice(0, 2);
      if (topTwo.length === 0) {
        const empty = document.createElement("div");
        empty.className = "card__empty";
        empty.textContent = "Nessun torneo disponibile";
        nextEl.appendChild(empty);
      } else {
        topTwo.forEach((t) => grid.appendChild(buildTournamentCard(t)));
        nextEl.appendChild(grid);
      }

      linksEl.innerHTML = `
        <div class="card__title">Link utili</div>
        <div class="links">
          <a class="link" href="/tornei/friends">Tutti i tornei</a>
          <a class="link" href="/classifica-annuale/${encodeURIComponent(year)}">Classifica annuale ${year}</a>
          <a class="link" href="/profilo">Profilo</a>
        </div>
      `;
    }

    function renderRecent(list) {
      const rows = (list || []).map((t) => {
        const id = encodeURIComponent(t.id);
        return `
          <tr>
            <td class="td-name">${t.name || ""}</td>
            <td>${fmtDate(t.datafine)}</td>
            <td>${statusBadge(t.status)}</td>
            <td class="td-actions">
              <a class="btn btn--small" href="/tornei/${id}/sviluppo">Classifica</a>
              <a class="btn btn--small" href="/tornei/${id}/pronostico">Pronostico</a>
            </td>
          </tr>
        `;
      });

      recentEl.innerHTML = `
        <div class="card__title">Tornei precedenti</div>
        <div class="table-wrap">
          <table class="table">
            <thead>
              <tr>
                <th>Torneo</th>
                <th>Fine</th>
                <th>Status</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              ${rows.join("") || `<tr><td colspan="4" class="td-empty">Nessun torneo</td></tr>`}
            </tbody>
          </table>
        </div>
      `;
    }

    async function load() {
      try {
        const res = await fetch(`${apiUrl}/friend/dashboard`, { credentials: "include" });
        if (!res.ok) {
          const txt = await res.text().catch(() => "");
          throw new Error(txt || `HTTP ${res.status}`);
        }
        const json = await res.json();
        const data = json && json.data ? json.data : null;
        if (!data) throw new Error("Dati dashboard non disponibili");

        renderCurrent(data.currentTournament);
        renderNext(data.nextTournaments, data.currentYear);
        renderRecent(data.recentTournaments);
      } catch (e) {
        showWarning(e.message || "Errore caricamento dashboard");
        renderCurrent(null);
        renderNext([], new Date().getFullYear());
        renderRecent([]);
      }
    }

    load();
  })();
</script>

<%- include('partials/footer'); -%>
