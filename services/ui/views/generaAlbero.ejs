<%- include('partials/head'); -%>
<link rel="stylesheet" href="https://fperucic.github.io/treant-js/Treant.css" />
<link rel="stylesheet" href="/css/treantTree.css" />
<title id="title"></title>
<link rel="stylesheet" href="/css/hamburger.css" />
<%- include('partials/header'); -%> <%- include('partials/hamburger'); -%>

<h1 id="nome-torneo"><%= tournamentId %></h1>

<div id="elenco alberi"><button id="newButton">NUOVO</button></div>
<div id="excludedWarning" class="hidden" style="margin: 10px 0; padding: 10px; border: 1px solid #f5c2c7; background: #f8d7da; color: #842029;">
  Torneo escluso: non è possibile generare un nuovo albero.
</div>

<div id="filter-bar" class="hidden">
  <label class="filter-label">
    <span class="label-text">Da:</span>
    <select id="fromRound"></select>
  </label>
  <label class="filter-label">
    <span class="label-text">A:</span>
    <select id="toRound"></select>
  </label>
  <button id="saveButton">SALVA</button>
  <button id="deleteButton">SCANCELLA</button>
</div>

<div id="scroll-container">
  <div id="chart-container">
    <div id="tree-simple" class="Treant"></div>
  </div>
</div>

<div id="dialogContainer"></div>

<script src="https://fperucic.github.io/treant-js/vendor/raphael.js"></script>
<script src="https://fperucic.github.io/treant-js/Treant.js"></script>

<script type="module">
  const user = <%- JSON.stringify(user || null) %>;
  import { Tournament } from "/js/Tournament.js";
  import { APP_ICONS } from "/js/icons.js";
  const apiUrl = "<%= apiUrl %>";
  const tournamentId = "<%= tournamentId %>";
  const tournament = (await Tournament.fetchTournament(tournamentId, apiUrl))
    .data[0];

  const effectiveRounds = (() => {
    const n = Number(tournament && tournament.roundopen);
    return Number.isFinite(n) && n > 0 ? n : 6;
  })();

  const isAdmin =
    user && (user.level === "admin" || user.level === "super");

  import {
    setup,
    renderTree,
    roundLabels,
    populateRoundSelects,
    saveAlbero,
    saveNewAlbero,
    deleteAlbero,
    genera,
    getAlberoMatches,
    getAlberi,
    setEditable,
    setWinnersEditable,
  } from "/js/alberoTorneo.js?v=<%= Date.now() %>";

  document.title = `programma ${tournament.name}`;
  document.getElementById("nome-torneo").textContent = tournament.name;

  populateRoundSelects(tournament, roundLabels);

  setup(tournament, user, apiUrl);

  const filterBar = document.getElementById("filter-bar");
  const saveBtn = document.getElementById("saveButton");
  const deleteBtn = document.getElementById("deleteButton");
  const newBtn = document.getElementById("newButton");
  const excludedWarning = document.getElementById("excludedWarning");
  const fromRoundSelect = document.getElementById("fromRound");
  const toRoundSelect = document.getElementById("toRound");

  const isExcludedTournament =
    tournament && String(tournament.status).toLowerCase() === "excluded";
  if (isExcludedTournament) {
    if (newBtn) newBtn.classList.add("hidden");
    if (excludedWarning) excludedWarning.classList.remove("hidden");
  }

  let mode = "none"; // none | new | existing
  let canEdit = false;

  async function selectTree(treeId) {
    const selected = await getAlberoMatches(treeId);
    const editable = Boolean(isAdmin || user.uuid === selected.ownerId);
    setEditable(editable);
    setWinnersEditable(editable);
    setUiState({ visible: true, _mode: "existing", _canEdit: editable });
    renderTree(effectiveRounds, 1);
  }

  function setUiState({ visible = false, _mode = "none", _canEdit = false } = {}) {
    mode = _mode;
    canEdit = Boolean(_canEdit);
    filterBar.classList.toggle("hidden", !visible);
    filterBar.classList.toggle("visible", visible);

    // bottoni azione
    saveBtn.classList.toggle("hidden", !visible || !canEdit);
    deleteBtn.classList.toggle("hidden", !visible || mode !== "existing" || !canEdit);
  }

  function renderFromDropdowns() {
    const fromRound = parseInt(fromRoundSelect.value);
    const toRound = parseInt(toRoundSelect.value);
    if (!Number.isFinite(fromRound) || !Number.isFinite(toRound)) return;

    // Garantiamo un range valido: from >= to
    if (toRound > fromRound) {
      toRoundSelect.value = String(fromRound);
      renderTree(fromRound, fromRound);
      return;
    }
    renderTree(fromRound, toRound);
  }

  const containerElencolberi = document.getElementById("elenco alberi");

  const alberi = await getAlberi(tournament);
  const dedupById = new Map();
  for (const tr of alberi || []) {
    if (!tr || !tr.id) continue;
    if (!dedupById.has(tr.id)) dedupById.set(tr.id, tr);
  }

  // 1 albero per torneo: se l'API restituisce sia quello dell'utente che quello del SUPERUSER,
  // scegliamo una sola entry, preferendo l'albero dell'utente.
  const alberiUnici = Array.from(dedupById.values());
  const alberoPreferito =
    alberiUnici.find((t) => t && t.ownerId === user.uuid) || alberiUnici[0] || null;

  const alberiDaMostrare = alberoPreferito ? [alberoPreferito] : [];

  if (alberiDaMostrare.length > 0) {
    // un albero solo per torneo: se esiste, non permettiamo NUOVO
    newBtn.classList.add("hidden");
  }

  for (const treeRow of alberiDaMostrare) {
    const divRiga = document.createElement("div");
    const albero = document.createElement("div");
    const nomeAlberoSpan = document.createElement("span");
    nomeAlberoSpan.textContent = treeRow.name;
    const nomeUserAlberoSpan = document.createElement("span");
    const bottoneAlbero = document.createElement("button");
    if (user.uuid === treeRow.ownerId) {
      
        nomeUserAlberoSpan.textContent = user.soprannome
      } else{
      nomeUserAlberoSpan.textContent = "PoPoSTaPo";
    }
    albero.append(nomeAlberoSpan, nomeUserAlberoSpan);
    albero.id = treeRow.id;
    albero.addEventListener("click", async (e) => {
      const treeId = e.currentTarget.id;
      await selectTree(treeId);
    });
    bottoneAlbero.textContent = APP_ICONS.EDIT;
    bottoneAlbero.type = "button";
    bottoneAlbero.addEventListener("click", async (e) => {
      e.preventDefault();
      e.stopPropagation();
      await selectTree(treeRow.id);
    });

    divRiga.append(bottoneAlbero, albero);
    containerElencolberi.appendChild(divRiga);
  }

  fromRoundSelect.addEventListener("change", renderFromDropdowns);
  toRoundSelect.addEventListener("change", renderFromDropdowns);

  saveBtn.addEventListener("click", async () => {
    if (!canEdit) return;
    if (mode === "new") {
      await saveNewAlbero(apiUrl);
      location.reload();
      return;
    }
    await saveAlbero(apiUrl);
  });

  newBtn.addEventListener("click", () => {
    if (isExcludedTournament) return;
    genera();
    setEditable(true);
    setWinnersEditable(true);
    setUiState({ visible: true, _mode: "new", _canEdit: true });
  });

  deleteBtn.addEventListener("click", async () => {
    if (!canEdit || mode !== "existing") return;
    await deleteAlbero();
    location.reload();
  });

  // stato iniziale
  setEditable(false);
  setWinnersEditable(false);
  setUiState({ visible: false, _mode: "none", _canEdit: false });
</script>

<%- include('partials/footer'); -%>
