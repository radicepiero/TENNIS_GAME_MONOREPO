<%- include('partials/head'); -%>
<link rel="stylesheet" href="/css/pronostico.css" />
<link rel="stylesheet" href="/css/hamburger.css" />
<%- include('partials/header'); -%>
<%- include('partials/hamburger'); -%>
    <h1 id="torneo"></h1>
    <div id="tournament-lock-message" style="display:none; text-align:center; margin: -10px 0 18px; padding: 10px 12px; border: 1px solid rgba(0,0,0,0.12); border-radius: 12px; background: rgba(255, 214, 0, 0.18);"></div>

    <div id="prediction-avatar" style="text-align:center; margin: 12px 0 18px;">
      <input id="prediction_avatar_url" type="hidden" value="<%= user && user.ui_avatar_url ? user.ui_avatar_url : '' %>" />
      <div
        id="prediction-avatar-uploader"
        data-upload-url="/pronostico/upload-avatar"
        data-preview-id="prediction-avatar-preview"
        data-image-url-input-id="prediction_avatar_url"
        data-status-id="prediction-avatar-status"
        style="display:inline-block;"
      >
        <button id="choose-prediction-avatar" type="button">scegli il tuo avatar per questo pronostico</button>
        <button id="save-prediction-avatar" type="button" style="display:none; margin-left: 10px;">Salva avatar</button>
        <input id="prediction_avatar_file" type="file" accept="image/*" style="display:none;" />
      </div>
      <div style="margin-top: 10px;">
        <img id="prediction-avatar-preview" alt="avatar" style="width: 44px; height: 44px; border-radius: 999px; object-fit: cover; border: 1px solid #ddd; display:none;" />
      </div>
      <div>
        <span id="prediction-avatar-status" style="display:inline-block; margin-top: 6px;"></span>
      </div>
    </div>

    <h2 id="winner-title" style="display:none;">Seleziona il vincitore</h2>
    <div id="semifinalists-list" class="semifinalists-container"></div>
    <h2>Totale punteggio: <span id="total-points">0</span></h2>
    <button id="submit-button" class="">Invia Pronostico</button>
    <button id="delete-button" class="">cancella Pronostico</button>
    <h2>Seleziona i semifinalisti (max 4)</h2>
    <div id="players-list" class="players-container"></div>
  <script src="/js/avatarUploader.js"></script>
  <script>
    document.addEventListener("DOMContentLoaded", async () => {
      const avatarRoot = document.getElementById("prediction-avatar-uploader");
      const chooseBtn = document.getElementById("choose-prediction-avatar");
      const saveAvatarBtn = document.getElementById("save-prediction-avatar");
      const fileInput = document.getElementById("prediction_avatar_file");
      const preview = document.getElementById("prediction-avatar-preview");
      const hiddenUrl = document.getElementById("prediction_avatar_url");
      const tournamentIdForAvatar = window.location.pathname.split("/")[2];

      const submitBtn = document.getElementById("submit-button");

      async function loadSavedAvatarForTournament() {
        try {
          const res = await fetch(`/ui/avatar/prediction/${encodeURIComponent(String(tournamentIdForAvatar || ""))}`, {
            method: "GET",
            credentials: "include",
          });
          if (!res.ok) return;
          const json = await res.json().catch(() => null);
          const u = json && json.image_url ? String(json.image_url) : "";
          if (u && hiddenUrl) hiddenUrl.value = u;
          if (u && preview) {
            preview.src = u;
            preview.style.display = "inline-block";
          }
        } catch (e) {}
      }

      try {
        const defaultUrl = hiddenUrl && hiddenUrl.value ? String(hiddenUrl.value) : "";
        if (defaultUrl && preview) {
          preview.src = defaultUrl;
          preview.style.display = "inline-block";
        }
      } catch (e) {}

      await loadSavedAvatarForTournament();

      if (chooseBtn && fileInput) {
        chooseBtn.addEventListener("click", () => {
          try {
            if (avatarRoot) {
              const oldUrl = hiddenUrl && hiddenUrl.value ? String(hiddenUrl.value) : "";
              avatarRoot.dataset.uploadUrl = `/pronostico/upload-avatar?tournament_id=${encodeURIComponent(
                String(tournamentIdForAvatar || "")
              )}&old_avatar_url=${encodeURIComponent(oldUrl)}`;
            }
          } catch (e) {}
          fileInput.click();
        });
      }

      if (avatarRoot && typeof window.setupAvatarUploader === "function") {
        window.setupAvatarUploader(avatarRoot, {
          onUploaded: (json) => {
            if (preview) preview.style.display = "inline-block";
            if (hiddenUrl && json && json.image_url) {
              hiddenUrl.value = json.image_url;
              if (preview) preview.src = json.image_url;
            }

            if (saveAvatarBtn) saveAvatarBtn.style.display = "inline-block";

            if (predictionEsiste && submitBtn) {
              submitBtn.textContent = "Salva Pronostico";
              submitBtn.classList.remove("hidden");
            }
          },
          onError: () => {},
        });
      }

      if (saveAvatarBtn) {
        saveAvatarBtn.addEventListener("click", async () => {
          try {
            const image_url = hiddenUrl && hiddenUrl.value ? String(hiddenUrl.value) : "";
            const res = await fetch(`/ui/avatar/prediction/${encodeURIComponent(String(tournamentIdForAvatar || ""))}`, {
              method: "PUT",
              credentials: "include",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ image_url }),
            });
            const json = await res.json().catch(() => null);
            if (!res.ok) {
              const msg = (json && (json.error || json.message)) || "Errore nel salvataggio";
              const statusEl = document.getElementById("prediction-avatar-status");
              if (statusEl) statusEl.textContent = msg;
              return;
            }
            if (json && json.image_url && hiddenUrl) hiddenUrl.value = String(json.image_url);
            if (json && json.image_url && preview) {
              preview.src = String(json.image_url);
              preview.style.display = "inline-block";
            }
            const statusEl = document.getElementById("prediction-avatar-status");
            if (statusEl) statusEl.textContent = "Salvato";
            saveAvatarBtn.style.display = "none";
          } catch (e) {
            const statusEl = document.getElementById("prediction-avatar-status");
            if (statusEl) statusEl.textContent = "Errore nel salvataggio";
          }
        });
      }

      // Funzione per ottenere i giocatori
      //---------------------------------------------------------------
      class PlayerCard {
        constructor(player, onCheckboxChange) {
          this.player = player;
          this.onCheckboxChange = onCheckboxChange;
          this.element = this.createPlayerElement();
        }
        createPlayerElement() {
          const div = document.createElement("div");
          div.id = `player-${this.player.name}`;
          div.classList.add("player");

          const checkbox = document.createElement("input");
          checkbox.type = "checkbox";
          checkbox.value = this.player.name;

          if (this.onCheckboxChange) {
            checkbox.onchange = (event) =>
              this.onCheckboxChange(event, this.player);
          }

          const img = document.createElement("img");
          img.src = this.player.image_src || "default.jpg";
          img.alt = this.player.image_alt || this.player.name;

          const playerId =
            this.player && this.player.id !== undefined && this.player.id !== null
              ? String(this.player.id)
              : "";
          const friendHref = playerId ? `/friend/player/${encodeURIComponent(playerId)}` : "";

          const imgWrap = document.createElement(friendHref ? "a" : "div");
          if (friendHref) {
            imgWrap.href = friendHref;
            imgWrap.style.textDecoration = "none";
          }
          imgWrap.appendChild(img);

          const punteggio = document.createElement("div");
          punteggio.textContent = this.player.Rankings.length
            ? `${this.player.Rankings[0].ranking} : ${this.player.puntiSemifinalist} / ${this.player.puntiWinner}`
            : "N/D";

          const label = document.createElement("label");
          label.textContent = this.player.name;

          const labelWrap = document.createElement(friendHref ? "a" : "div");
          if (friendHref) {
            labelWrap.href = friendHref;
            labelWrap.style.textDecoration = "none";
            labelWrap.style.color = "inherit";
          }
          labelWrap.appendChild(label);

          const country = document.createElement("div");
          country.textContent = this.player.country;

          div.append(punteggio, imgWrap, checkbox, labelWrap, country);
          return div;
        }

        getElement() {
          return this.element;
        }
      }

      async function fetchPlayers(rankingDate) {
        try {
          const normalizeRankingDate = (v) => {
            if (!v) return null;
            const s = String(v);
            if (s.length >= 10) return s.slice(0, 10);
            return s;
          };

          const normalizedDate = normalizeRankingDate(rankingDate);

          const url = normalizedDate
            ? `<%= apiUrl %>/players/ranking/${encodeURIComponent(normalizedDate)}`
            : `<%= apiUrl %>/players/ranking`;

          const response = await fetch(
            url,
            {
              method: "GET",
              //credentials: "include", // <<< necessario
            }
          );
          if (!response.ok)
          throw new Error("Errore nel caricamento dei giocatori");
        const players = (await response.json()).data;
        //console.log(players);
        console.log("typeof punteggioSemifinalist",tournament.Scripts)
        let _punteggioWinner = {};
        let _punteggioSemifinalist = {};
        if (tournament.Scripts.length) {
          _punteggioWinner = tournament.Scripts.find((el) => {
            return el.name === "punteggioWinner";
          });
          console.log(_punteggioWinner)
          _punteggioSemifinalist = tournament.Scripts.find((el) => {
              return el.name === "punteggioSemifinalist";
            });
            if (_punteggioWinner && _punteggioWinner.script) {
              eval(_punteggioWinner.script);
            }
            if (_punteggioSemifinalist && _punteggioSemifinalist.script) {
              eval(_punteggioSemifinalist.script);
            }
            players.forEach((player) => {
              player.puntiSemifinalist = 0;
              player.puntiWinner = 0;

              if (!player.Rankings || !player.Rankings.length) return;

              const rawRanking = player.Rankings[0].ranking;
              let ranking = Number(rawRanking);
              if (!Number.isFinite(ranking)) {
                const m = String(rawRanking).match(/\d+/);
                ranking = m ? Number(m[0]) : NaN;
              }
              if (!Number.isFinite(ranking)) return;

              if (typeof punteggioSemifinalist === "function") {
                const v = punteggioSemifinalist(ranking);
                player.puntiSemifinalist = Number.isFinite(Number(v)) ? Number(v) : 0;
              }
              if (typeof punteggioWinner === "function") {
                const v = punteggioWinner(ranking);
                player.puntiWinner = Number.isFinite(Number(v)) ? Number(v) : 0;
              }
            });
          } else {
            players.forEach((player) => {
              player.puntiSemifinalist = 0;
              player.puntiWinner = 0;
            });
          }
          //console.log(players);
          return players;
        } catch (error) {
          console.error(error);
          return [];
        }
      }

      async function fetchTournament(tournament_id) {
        try {
          let response = await fetch(
            `<%= apiUrl %>/tournaments/${tournament_id}/scripts`,
            {
              method: "GET",
              //credentials: "include", // <<< necessario
            }
          );
          return await response.json();
        } catch (error) {
          console.error(error);
        }
      }

      // Funzione per ottenere una prediction esistente
      async function fetchPrediction(tournament_id) {
        try {
          const url = `<%= apiUrl %>/predictions/tournaments/${tournament_id}/user`;
          const pred = await fetch(url, {
            method: "GET",
            //credentials: "include", // <<< necessario
          });
          if (!pred.ok) predictionEsiste = false;
          const { data } = await pred.json();
          if (data[0].rows) {
            predictionEsiste = true;
            if (submitBtn) submitBtn.textContent = "Salva Pronostico";
            if (data[0].avatar_url && hiddenUrl) {
              hiddenUrl.value = data[0].avatar_url;
              if (preview) {
                preview.src = data[0].avatar_url;
                preview.style.display = "inline-block";
              }
            }
            return data[0].rows;
          }
        } catch (error) {
          console.error("Errore nel recupero della prediction:", error);
        }
      }

      // Funzione per aggiornare i semifinalisti
      async function updateSemifinalists(prediction = false) {
        /*prediction
     [ {…}, {…}, {…}, {…} ]
      { player_id: 2, prediction: "semifinalist" }
      */
        /*semifinalists
      Array(4) [ {…}, {…}, {…}, {…} ]
      Object { id: 1, name: "Jannik Sinner", country: "ITA", … }​
      country: "ITA"
      created_at: "2025-02-27T18:55:14.697Z"
      id: 1
      image_alt: "Jannik Sinner"
      image_src: "https://www.atptour.com/-/media/alias/player-headshot/s0ag"
      name: "Jannik Sinner"
      prediction: "semifinalist"
      profile_url: "https://www.atptour.comhttps://www.atptour.com/en/players/jannik-sinner/s0ag/overview"
      // */
        const convertPredictionToSemifinalist = async (predictionRow) => {
          const player = await players.find(
            (player) => player.id === predictionRow.player_id
          );
          if (!player) {
            console.error("Player not found for id:", predictionRow.player_id);
            return null;
          }
          player.prediction = predictionRow.prediction;
          return player;
        };

        semifinalistsList.innerHTML = "";

        if (prediction) {
          for (const el of prediction) {
            const sem = await convertPredictionToSemifinalist(el); // Ascolta la promessa
            semifinalists.push(sem);
          }
        }

        const refreshPredictionUi = () => {
          const totalEl = document.getElementById("total-points");
          if (totalEl) {
            const total = (semifinalists || []).reduce((acc, p) => {
              if (!p) return acc;
              if (p.prediction === "winner") return acc + (Number(p.puntiWinner) || 0);
              return acc + (Number(p.puntiSemifinalist) || 0);
            }, 0);
            totalEl.textContent = String(total);
          }

          const winnerTitle = document.getElementById("winner-title");
          const canPickWinner = (semifinalists || []).length === 4;
          if (winnerTitle) winnerTitle.style.display = canPickWinner ? "block" : "none";

          if (!isLockedTournament && submitButton) {
            submitButton.className =
              canPickWinner && !(semifinalists || []).every((p) => p.prediction !== "winner")
                ? "visible"
                : "hidden";
          }
        };

        semifinalists.forEach((player) => {
          //inizializzo tutti a "semifinalist"
          if (!prediction) {
            player.prediction = "semifinalist";
          }
          //definisco le azioni che devono essere fatte quando si seleziona la checkbox
          //togliere il giocatore da semifinalist,  richaimare updateSemifinalists,
          //cercare il giocatore fra i player e mettere checkbox.checkeda false
          function checkBoxChange(event, player) {
            if (event.target.checked) {
            } else {
              //event.target.checked = false;
              semifinalists = semifinalists.filter(
                (p) => p.name !== player.name
              );
            }
            const el = document
              .getElementById("players-list")
              .querySelector(`input[type="checkbox"][value='${player.name}']`);
            el.checked = false;
            updateSemifinalists();
          }

          //costruisco la playercard
          const playerCard = new PlayerCard(player, checkBoxChange);
          // console.log("playercard", playerCard.getElement());
          const playerElement = playerCard.getElement();
          const checkbox = playerElement.querySelector(
            "input[type='checkbox']"
          );
          checkbox.checked = true;
          //console.log("semifinalist", playerCard.getElement());
          //aggiungo il radio button per indicare il finalista
          const radio = document.createElement("input");
          radio.type = "radio";
          radio.id = `rd-${player.id}`;
          radio.name = "winner";
          radio.value = player.name;
          const label = document.createElement("label");
          label.htmlFor = radio.id;
          label.innerHTML = "Vincitore";
          const d = document.createElement("div");
          player.prediction === "winner"
            ? (radio.checked = true)
            : (radio.checked = false);
          d.append(radio, label);
          radio.onchange = function radioOnchange(event) {
            //metto tutti a "semifinalist" ma il target a "winner"
            //winnerName.innerText = "this.player.name";
            if (event.target.checked) {
              //console.log("event.target.checked", event.target.checked);
              semifinalists.forEach((p) => (p.prediction = "semifinalist"));
              player.prediction = "winner";
              //aggiorno lo stile aggiornando le classi
              document
                .querySelectorAll(".winner")
                .forEach((el) => el.classList.remove("winner"));
              document
                .getElementById(`player-${player.name}`)
                .classList.add("winner");
              refreshPredictionUi();
            }
          };
          const sem = playerCard.getElement();
          player.prediction === "winner"
            ? sem.classList.add("winner")
            : sem.classList.add("semifinalist");
          sem.insertBefore(d, sem.firstChild);
          //console.log(sem);
          semifinalistsList.appendChild(sem);
          //predictionEsiste? deleteButton.
        });

        refreshPredictionUi();
      }
      //-----------fine updateSemifinalsits
      //---------------------------------------------------------------
      let semifinalists = [];
      let predictionEsiste = false;
      let isLockedTournament = false;
      const playersList = document.getElementById("players-list");
      const semifinalistsList = document.getElementById("semifinalists-list");
      //  const winnerName = document.getElementById("winner-name");
      const submitButton = document.getElementById("submit-button");
      const deleteButton = document.getElementById("delete-button");
      if (predictionEsiste) {
        submitButton.className = "visible";
        deleteButton.className = "visible";
      } else {
        submitButton.className = "hidden";
        deleteButton.className = "hidden";
      }
      const tournament_id = window.location.pathname.split("/")[2];
      // Caricamento giocatori e creazione elementi
      const tournament = (await fetchTournament(tournament_id)).data[0];
      isLockedTournament = ["completed", "in-progress", "excluded"].includes(String(tournament.status));
      const titolo = document.getElementById("torneo");
      titolo.innerHTML = tournament.name;

      const lockEl = document.getElementById("tournament-lock-message");
      if (lockEl) {
        const st = tournament.status ? String(tournament.status).toLowerCase() : "";
        let msg = "";
        if (st === "in-progress") {
          msg = "Pronostico non modificabile: il torneo è in corso.";
        } else if (st === "completed") {
          msg = "Pronostico non modificabile: il torneo è completato.";
        } else if (st === "excluded") {
          msg = "Pronostico non modificabile: il torneo è escluso.";
        }
        if (msg) {
          lockEl.textContent = msg;
          lockEl.style.display = "block";
        } else {
          lockEl.style.display = "none";
        }
      }
      // console.log("tournament", tournament);
      const players = await fetchPlayers(tournament.ranking_date);
      //console.log("players", players);
      const prediction = await fetchPrediction(tournament_id);
      if (predictionEsiste) {
        await updateSemifinalists(prediction);
        deleteButton.className = "visible";
      }

      if (isLockedTournament) {
        submitButton.className = "hidden";
        deleteButton.className = "hidden";
      }
      //console.log("prediction", prediction);

      players.forEach((player) => {
        // Funzione per gestire la selezione del giocatore
        function checkBoxChange(event, player) {
          if (isLockedTournament) {
            event.target.checked = false;
            return;
          }
          if (event.target.checked) {
            if (semifinalists.length < 4) {
              player.prediction = "semifinalist";
              semifinalists.push(player);
            } else {
              event.target.checked = false;
              alert("Puoi selezionare massimo 4 semifinalisti!");
            }
          } else {
            semifinalists = semifinalists.filter((p) => p.name !== player.name);
          }
          updateSemifinalists();
        }

        let giocatoreInPrediction = semifinalists.some(
          (el) => el.name === player.name
        );

        const playerCard = new PlayerCard(player, checkBoxChange);
        // console.log("playercard", playerCard.getElement());
        const playerElement = playerCard.getElement();
        // Aggiorna lo stato della checkbox
        const checkbox = playerElement.querySelector("input[type='checkbox']");
        if (checkbox) {
          checkbox.checked = giocatoreInPrediction;
        }

        playersList.appendChild(playerElement);
      });

      // Gestione invio pronostico
      submitButton.addEventListener("click", async () => {
        if (isLockedTournament) {
          alert("Pronostici bloccati per questo torneo");
          return;
        }
        const pronostico = {
          tournament_id: window.location.pathname.split("/")[2],
          avatar_url: hiddenUrl && hiddenUrl.value ? hiddenUrl.value : undefined,
          rows: semifinalists.map((player) => ({
            player_id: player.id,
            prediction: player.prediction,
          })),
        };
        console.log("pronostico", pronostico);
        if (
          pronostico.rows.length !== 4 ||
          pronostico.rows.every((p) => p.prediction !== "winner")
        ) {
          alert("Devi selezionare 4 semifinalisti e un vincitore!");
          return;
        }

        try {
          const response = await fetch("<%= apiUrl %>/predictions", {
            method: "POST",
            //credentials: "include", // <<< necessario
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(pronostico),
          });

          if (!response.ok) throw new Error(`Errore HTTP: ${response.status}`);
          location.reload();
          alert("Pronostico inviato con successo!");
        } catch (error) {
          console.error("Errore nell'invio dei dati:", error);
        }
      });

      deleteButton.addEventListener("click", async () => {
        if (isLockedTournament) {
          alert("Pronostici bloccati per questo torneo");
          return;
        }

        try {
          const avatarToDelete = hiddenUrl && hiddenUrl.value ? String(hiddenUrl.value) : "";
          if (avatarToDelete && avatarToDelete.startsWith("/uploads/predictions/")) {
            await fetch("/pronostico/delete-avatar", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ avatar_url: avatarToDelete }),
              credentials: "include",
            }).catch(() => null);
          }
        } catch (e) {}

        const pronostico = {
          tournament_id: window.location.pathname.split("/")[2],
          rows: semifinalists.map((player) => ({
            player_id: player.id,
            prediction: player.prediction,
          })),
        };

        if (
          pronostico.rows.length !== 4 ||
          pronostico.rows.every((p) => p.prediction !== "winner")
        ) {
          alert("Devi selezionare 4 semifinalisti e un vincitore!");
          return;
        }

        try {
          const response = await fetch("<%= apiUrl %>/predictions", {
            method: "DELETE",
            //credentials: "include", // <<< necessario
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(pronostico),
          });

          if (!response.ok) throw new Error(`Errore HTTP: ${response.status}`);
          location.reload();
          alert("Pronostico eliminato!");
        } catch (error) {
          console.error(
            "Errore nell'invio dei dati per la cancellazione:",
            error
          );
        }
      });
    });
  </script>
<%- include('partials/footer'); -%>
