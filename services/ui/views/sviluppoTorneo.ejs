<%- include('partials/head'); -%>
<link rel="stylesheet" href="/css/australian-open-2025-pronostico.css" />
<link rel="stylesheet" href="/css/hamburger.css" />
<%- include('partials/header'); -%>
<%- include('partials/hamburger'); -%>

<h1 id="titolo" class="fase-title" role="button" tabindex="0">
  <button type="button" id="titolo-draw" aria-label="Tabellone"></button>
  <span id="titolo-text"><%= tournamentId %></span>
  <button type="button" id="titolo-edit" aria-label="Modifica"></button>
</h1>

<div id="fase-modal" class="fase-modal" aria-hidden="true">
  <div class="fase-modal__backdrop" data-close="1"></div>
  <div class="fase-modal__panel" role="dialog" aria-modal="true" aria-label="Seleziona fase">
    <div class="fase-modal__header">
      <div class="fase-modal__title">Seleziona fase</div>
      <button type="button" class="fase-modal__close" data-close="1" aria-label="Chiudi">×</button>
    </div>
    <div id="fase-modal-options" class="fase-modal__options"></div>
  </div>
</div>

<div class="column-container" id="columns"></div>
<script type="application/json" id="bootstrap"><%- JSON.stringify({ tournamentId, tournamentName, apiUrl, loggedUserUuid: (user && user.uuid) ? user.uuid : '' }) %></script>
<script type="module" src="/js/ui/pages/sviluppoTorneo.js?v=<%= Date.now() %>"></script>
<%- include('partials/footer'); -%>
