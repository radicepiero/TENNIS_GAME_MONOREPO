<%- include('partials/head'); -%>
<link rel="stylesheet" href="/css/australian-open-2025-pronostico.css" />
<!--<link rel="stylesheet" href="/css/hamburger.css?v=1.0" />-->
<%- include('partials/header'); -%>
<h1 id = "titolo"><%= tournamentId %></h1>
<header class="hamburger-header">
  <div class="hamburger-menu">
    <button class="menu-toggle" aria-label="Toggle menu">☰</button>
    <nav class="menu">
      <ul>
        <li><a href="#" data-source="0">Pronostici</a></li>
        <li><a href="#" data-source="1">Primo turno</a></li>
        <li><a href="#" data-source="2">Secondo turno</a></li>
        <li><a href="#" data-source="3">Ottavi di finale</a></li>
        <li><a href="#" data-source="4">Quarti di finale</a></li>
        <li><a href="#" data-source="5">Semifinali</a></li>
        <li><a href="#" data-source="6">Finale</a></li>
      </ul>
    </nav>
  </div>
</header>

<div class="column-container" id="columns"></div>
<script type="module">
  console.log("sviluppoTorneo init", {
    tournamentId: "<%= tournamentId %>",
    tournamentName: "<%= tournamentName || '' %>",
    apiUrl: "<%= apiUrl %>",
  });

  const showError = (msg) => {
    const el = document.getElementById("columns");
    if (!el) return;
    el.innerHTML = `<div style="padding:12px;border:1px solid #f99;background:#fff0f0;color:#900;max-width:720px;margin:12px auto;">${msg}</div>`;
  };

  (async () => {
    let creaColonne;
    try {
      ({ creaColonne } = await import("/js/creaColonne.js"));
    } catch (e) {
      console.error("Import creaColonne failed", e);
      showError("Errore caricamento script sviluppo (creaColonne.js)");
      return;
    }

    const menuToggle = document.querySelector(".menu-toggle");
    const menu = document.querySelector(".menu");
    const menuLinks = document.querySelectorAll(".menu a");
    const titleElement = document.getElementById("titolo");

    const onSelect = async (event) => {
      event.preventDefault();
      const dataSource = event.target.dataset.source;
      try {
        const columnContainer = document.getElementById("columns");
        columnContainer.innerHTML = "";
        const apiUrl = "<%= apiUrl %>";
        await creaColonne("<%= tournamentId %>", dataSource, apiUrl, "<%= (user && user.uuid) ? user.uuid : '' %>");
        const selectedOptionText = event.target.textContent;
        titleElement.textContent = `${selectedOptionText.toUpperCase()} <%= tournamentName || '' %>`;
        menu.classList.remove("open");
      } catch (error) {
        console.error("Errore durante lo sviluppo:", error);
        showError("Errore durante il caricamento dati sviluppo");
      }
    };

    menuLinks.forEach((link) => link.addEventListener("click", onSelect));

    if (menuToggle) {
      menuToggle.addEventListener("click", () => menu.classList.toggle("open"));
    }

    const runInitial = () => {
      const lastMenuLink = menuLinks[menuLinks.length - 1];
      if (!lastMenuLink) return;
      // let styles/layout settle
      requestAnimationFrame(() => lastMenuLink.click());
    };

    if (document.readyState === "loading") {
      window.addEventListener("DOMContentLoaded", runInitial);
    } else {
      runInitial();
    }
  })();
</script>
<%- include('partials/footer'); -%>
