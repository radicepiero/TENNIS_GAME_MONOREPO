<%- include('partials/head'); -%>
<link rel="stylesheet" href="/css/hamburger.css" />
<link rel="stylesheet" href="/css/classifica.css" />
<title>Classifica ATP</title>
<%- include('partials/header'); -%> <%- include('partials/hamburger'); -%>
<h1>Evoluzione della classifica dei primi 100 tennisti</h1>
<div class="table-container">
  <table id="rankingTable">
    <thead>
      <tr id="datesHeader">
        <th class="player-col">Giocatore</th>
        <th>Rank</th>
        <!-- Date headers will be inserted by JavaScript -->
      </tr>
    </thead>
    <tbody id="rankingBody">
      <!-- Rows will be generated by JavaScript -->
    </tbody>
  </table>
</div>

<script type="application/json" id="bootstrap"><%- JSON.stringify({ apiUrl: (locals && locals.apiUrl) ? locals.apiUrl : (typeof apiUrl !== 'undefined' ? apiUrl : '/api') }) %></script>
<script type="module" src="/js/ui/pages/tennisti.js?v=<%= Date.now() %>"></script>

<%- include('partials/footer'); -%>
