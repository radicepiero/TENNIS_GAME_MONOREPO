<%- include('partials/head'); -%>
<link rel="stylesheet" href="/css/hamburger.css" />
<link rel="stylesheet" href="/css/classifica.css" />
<title>Classifica ATP</title>
<%- include('partials/header'); -%> <%- include('partials/hamburger'); -%>
<h1>Evoluzione della classifica dei primi 100 tennisti</h1>
<div class="table-container">
  <table id="rankingTable">
    <thead>
      <tr id="datesHeader">
        <th class="player-col">Giocatore</th>
        <th>Rank</th>
        <!-- Date headers will be inserted by JavaScript -->
      </tr>
    </thead>
    <tbody id="rankingBody">
      <!-- Rows will be generated by JavaScript -->
    </tbody>
  </table>
</div>

<script type="module">
  import { Ranking } from "/js/Ranking.js";
  import Player from "/js/Player.js";

  function generateRankingTable(data) {
    if (!Array.isArray(data)) {
      console.error("Invalid data format. Expected an array.");
      return;
    }

    // Estrai e ordina le date
    const allDates = data
      .map((item) => item.date && formatDate(item.date))
      .filter(Boolean);
    const uniqueDates = new Set(allDates);
    const dates = Array.from(uniqueDates).sort(
      (a, b) => new Date(b) - new Date(a)
    );

    if (dates.length === 0) {
      console.error("No valid dates found in the data.");
      return;
    }

    // Crea la struttura dati ottimizzata
    const rankingMap = new Map();
    const playerInfoMap = new Map(); // Mappa per info giocatori

    data.forEach((item) => {
      if (!item.date || !item.ranking || !item.Player) return;

      const dateStr = formatDate(item.date);
      if (!dateStr) return;

      if (!rankingMap.has(dateStr)) {
        rankingMap.set(dateStr, new Map());
      }

      // Salva le info del giocatore se non presenti
      if (!playerInfoMap.has(item.Player.id)) {
        playerInfoMap.set(item.Player.id, {
          name: item.player_name,
          image_alt: item.Player.image_alt,
          image_src: item.Player.image_src,
        });
      }

      rankingMap.get(dateStr).set(item.ranking, {
        player_id: item.Player.id,
        ranking: item.ranking,
      });
    });

    // Pulisci gli header esistenti
    const datesHeader = document.getElementById("datesHeader");
    while (datesHeader.children.length > 2) {
      datesHeader.removeChild(datesHeader.lastChild);
    }

    // Aggiungi nuovi header
    const headerFragment = document.createDocumentFragment();
    dates.forEach((date, idx) => {
      const th = document.createElement("th");
      th.className = "date-header";
      th.textContent = formatDmyShort(date);
      // Evita che le date più recenti vengano coperte dalle precedenti (overlap per rotazione)
      // Prima colonna data = più recente => z-index più alto
      th.style.zIndex = String((dates.length - idx) + 2);
      headerFragment.appendChild(th);
    });
    datesHeader.appendChild(headerFragment);

    // Genera le righe della tabella
    const tbody = document.getElementById("rankingBody");
    tbody.innerHTML = "";

    for (let rank = 1; rank <= 100; rank++) {
      const row = document.createElement("tr");

      // Colonna Giocatore (con toggle)
      const playerCol = document.createElement("td");
      playerCol.className = "player-col";

      // Trova il giocatore per questa posizione (usiamo la data più recente)
      const firstDate = dates[0];
      const firstDateData = rankingMap.get(firstDate)?.get(rank);
      let playerData = null;

      if (firstDateData) {
        playerData = playerInfoMap.get(firstDateData.player_id);
      }

      if (playerData) {
        playerCol.innerHTML = `
          <label class="player-toggle">
            <input type="checkbox" class="player-toggle-checkbox"
                   data-player-id="${firstDateData.player_id}">
            <span class="player-name">${playerData.name}</span>
            <img src="${playerData.image_src}"
                 alt="${playerData.image_alt}"
                 class="player-avatar"
                 style="display: none">
          </label>
        `;
      } else {
        playerCol.textContent = `Rank ${rank}`;
      }
      row.appendChild(playerCol);

      // Colonna Rank
      const rankCell = document.createElement("td");
      rankCell.textContent = rank;
      rankCell.className = "rank-col";
      row.appendChild(rankCell);

      // Colonne Date (solo nomi inizialmente)
      dates.forEach((date) => {
        const cell = document.createElement("td");
        const dateData = rankingMap.get(date)?.get(rank);

        if (dateData) {
          const playerData = playerInfoMap.get(dateData.player_id);
          if (playerData) {
            cell.innerHTML = `
              <img src="${playerData.image_src}"
                   alt="${playerData.image_alt}"
                   class="player-avatar"
                   data-player-id="${dateData.player_id}"
                   style="display: none">
              <span class="player-name">${playerData.name}</span>
            `;
          } else {
            cell.textContent = "-";
          }
        } else {
          cell.textContent = "-";
        }
        row.appendChild(cell);
      });

      tbody.appendChild(row);
    }

    // Gestione dei toggle
    document.querySelectorAll(".player-toggle-checkbox").forEach((checkbox) => {
      // Forza tutti i toggle a unchecked all'inizio
      checkbox.checked = false;

      // Cancella eventuali preferenze salvate
      const playerId = checkbox.dataset.playerId;
      const prefs = JSON.parse(localStorage.getItem("playerImagePrefs")) || {};
      delete prefs[playerId];
      localStorage.setItem("playerImagePrefs", JSON.stringify(prefs));

      checkbox.addEventListener("change", (e) => {
        const playerId = e.target.dataset.playerId;
        const isVisible = e.target.checked;

        togglePlayerImages(playerId, isVisible);

        // Salva la preferenza solo se checked
        const prefs =
          JSON.parse(localStorage.getItem("playerImagePrefs")) || {};
        if (isVisible) {
          prefs[playerId] = true;
        } else {
          delete prefs[playerId];
        }
        localStorage.setItem("playerImagePrefs", JSON.stringify(prefs));
      });
    });
  }

  function togglePlayerImages(playerId, show) {
    document
      .querySelectorAll(`.player-avatar[data-player-id="${playerId}"]`)
      .forEach((img) => {
        img.style.display = show ? "inline-block" : "none";
        // Mostra il nome solo quando l'immagine è nascosta
        const nameSpan = img.nextElementSibling;
        if (nameSpan && nameSpan.classList.contains("player-name")) {
          nameSpan.style.display = show ? "none" : "inline";
        }
      });
  }

  function formatDate(dateInput) {
    if (!dateInput) return null;
    try {
      const date = new Date(dateInput);
      return isNaN(date.getTime()) ? null : date.toISOString().split("T")[0];
    } catch (e) {
      console.warn(`Invalid date: ${dateInput}`);
      return null;
    }
  }

  function formatDmyShort(ymd) {
    if (!ymd) return "";
    const s = String(ymd);
    if (s.length < 10) return s;
    const [yyyy, mm, dd] = s.split("-");
    if (!yyyy || !mm || !dd) return s;
    return `${dd}-${mm}-${String(yyyy).slice(-2)}`;
  }

  document.addEventListener("DOMContentLoaded", async () => {
    try {
      const rankingData = await Ranking.query({
        API: "<%= apiUrl %>",
        ranking_min: 1,
        ranking_max: 100,
        includePlayer: true,
      });
      generateRankingTable(rankingData);

      // Mostra tutti i nomi inizialmente
      document.querySelectorAll(".player-name").forEach((nameSpan) => {
        nameSpan.style.display = "inline";
      });
    } catch (error) {
      console.error("Error loading rankings:", error);
      document.getElementById("rankingBody").innerHTML = `
        <tr><td colspan="100%">Errore nel caricamento dei dati</td></tr>
      `;
    }
  });
</script>

<%- include('partials/footer'); -%>
